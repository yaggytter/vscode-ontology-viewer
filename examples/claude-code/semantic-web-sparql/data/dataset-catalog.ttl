# Riverbend Open Data Catalog — a DCAT + PROV-O catalog with lineage.
# LLM/AI use: provenance-aware answers — "which dataset did this number come from,
# who produced it, and under what license?" can be answered from explicit links.
#
# The catalog, agencies, datasets, figures, and license pages are fictional.

@prefix : <https://example.org/dataset-catalog#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dataset-catalog> a owl:Ontology ;
  rdfs:label "Riverbend Open Data Catalog"@en, "リバーベンド・オープンデータカタログ"@ja ;
  rdfs:comment "A fictional city data catalog using DCAT for datasets and distributions and PROV-O for lineage. Purpose: provenance-aware LLM answers — trace a published figure back to its dataset, the activity that generated it, the agent responsible, and the license that governs reuse."@en .

# --- Classes used (declared so the schema view shows the DCAT/PROV backbone) ---
dcat:Catalog a owl:Class ; rdfs:label "Catalog"@en .
# dcat:Dataset is a kind of prov:Entity, following the DCAT–PROV alignment.
dcat:Dataset a owl:Class ; rdfs:label "Dataset"@en ; rdfs:subClassOf prov:Entity .
dcat:Distribution a owl:Class ; rdfs:label "Distribution"@en .
prov:Entity a owl:Class ; rdfs:label "Entity"@en .
prov:Activity a owl:Class ; rdfs:label "Activity"@en .
prov:Agent a owl:Class ; rdfs:label "Agent"@en .
dct:LicenseDocument a owl:Class ; rdfs:label "License Document"@en .

dcat:dataset a owl:ObjectProperty ; rdfs:label "dataset"@en ; rdfs:domain dcat:Catalog ; rdfs:range dcat:Dataset .
dcat:distribution a owl:ObjectProperty ; rdfs:label "distribution"@en ; rdfs:domain dcat:Dataset ; rdfs:range dcat:Distribution .
dct:publisher a owl:ObjectProperty ; rdfs:label "publisher"@en ; rdfs:domain dcat:Dataset ; rdfs:range prov:Agent .
dct:license a owl:ObjectProperty ; rdfs:label "license"@en ; rdfs:domain dcat:Dataset ; rdfs:range dct:LicenseDocument .
prov:wasDerivedFrom a owl:ObjectProperty ; rdfs:label "was derived from"@en ; rdfs:domain prov:Entity ; rdfs:range prov:Entity .
prov:wasGeneratedBy a owl:ObjectProperty ; rdfs:label "was generated by"@en ; rdfs:domain prov:Entity ; rdfs:range prov:Activity .
prov:used a owl:ObjectProperty ; rdfs:label "used"@en ; rdfs:domain prov:Activity ; rdfs:range prov:Entity .
prov:wasAssociatedWith a owl:ObjectProperty ; rdfs:label "was associated with"@en ; rdfs:domain prov:Activity ; rdfs:range prov:Agent .
:reportedTotal a owl:DatatypeProperty ; rdfs:label "reported total"@en ;
  rdfs:comment "A headline figure published in the dataset, so an answer can cite where the number came from."@en ;
  rdfs:domain dcat:Dataset ; rdfs:range xsd:integer .

# --- Agents ---
:transitOffice a prov:Agent, foaf:Organization ; rdfs:label "Riverbend Transit Office"@en .
:analyticsTeam a prov:Agent, foaf:Organization ; rdfs:label "Riverbend City Analytics Team"@en .
:sensorVendor a prov:Agent, foaf:Organization ; rdfs:label "Cobalt Sensing Co."@en .

# --- Licenses (fictional pages) ---
:openLicense a dct:LicenseDocument ; rdfs:label "Riverbend Open Data License 1.0"@en ;
  rdfs:seeAlso <https://example.org/licenses/riverbend-open-1.0> .
:restrictedLicense a dct:LicenseDocument ; rdfs:label "Riverbend Internal Use License"@en ;
  rdfs:seeAlso <https://example.org/licenses/riverbend-internal> .

# --- Catalog ---
:catalog a dcat:Catalog ; dct:title "Riverbend Open Data"@en ;
  dct:publisher :analyticsTeam ;
  dcat:dataset :rawCounts, :ridershipDaily, :ridershipMonthly .

# --- Datasets with lineage ---
:rawCounts a dcat:Dataset ; dct:title "Raw Turnstile Counts"@en ;
  dct:description "Unprocessed per-gate entry counts exported by station sensors."@en ;
  dct:publisher :sensorVendor ; dct:license :restrictedLicense ;
  dct:issued "2026-03-01"^^xsd:date ;
  dcat:distribution :rawCountsCsv .
:ridershipDaily a dcat:Dataset ; dct:title "Daily Ridership by Station"@en ;
  dct:description "Cleaned daily entries per station, duplicates and sensor faults removed."@en ;
  dct:publisher :transitOffice ; dct:license :openLicense ;
  dct:issued "2026-04-02"^^xsd:date ;
  prov:wasDerivedFrom :rawCounts ; prov:wasGeneratedBy :cleaningRun ;
  dcat:distribution :ridershipDailyCsv, :ridershipDailyJson .
:ridershipMonthly a dcat:Dataset ; dct:title "Monthly Ridership Summary"@en ;
  dct:description "Monthly totals; reports March 2026 network ridership of 1,284,300 entries."@en ;
  dct:publisher :analyticsTeam ; dct:license :openLicense ;
  dct:issued "2026-04-10"^^xsd:date ;
  prov:wasDerivedFrom :ridershipDaily ; prov:wasGeneratedBy :monthlyAggregation ;
  :reportedTotal 1284300 ;
  dcat:distribution :ridershipMonthlyCsv .

# --- Activities ---
:cleaningRun a prov:Activity ; rdfs:label "Sensor data cleaning run 2026-04"@en ;
  prov:used :rawCounts ; prov:wasAssociatedWith :transitOffice ;
  prov:endedAtTime "2026-04-02T06:00:00Z"^^xsd:dateTime .
:monthlyAggregation a prov:Activity ; rdfs:label "Monthly aggregation 2026-03"@en ;
  prov:used :ridershipDaily ; prov:wasAssociatedWith :analyticsTeam ;
  prov:endedAtTime "2026-04-10T09:30:00Z"^^xsd:dateTime .

# --- Distributions ---
:rawCountsCsv a dcat:Distribution ; dct:format "CSV" ;
  dcat:accessURL <https://example.org/data/raw-turnstile-counts.csv> .
:ridershipDailyCsv a dcat:Distribution ; dct:format "CSV" ;
  dcat:downloadURL <https://example.org/data/ridership-daily.csv> .
:ridershipDailyJson a dcat:Distribution ; dct:format "JSON" ;
  dcat:downloadURL <https://example.org/data/ridership-daily.json> .
:ridershipMonthlyCsv a dcat:Distribution ; dct:format "CSV" ;
  dcat:downloadURL <https://example.org/data/ridership-monthly.csv> .
