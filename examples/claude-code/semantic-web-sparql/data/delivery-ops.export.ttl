    rdfs:range xsd:string;
    rdfs:label "status";
    oont:apiName "status";
    oont:dataType "string";
    oont:enumValue "pending", "assigned", "inTransit", "delayed", "delivered".
<urn:object-ontology:harbor-city-delivery-ops#Shipment.weightKg> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
    rdfs:range xsd:double;
    rdfs:label "weightKg";
    oont:apiName "weightKg";
    oont:dataType "double";
    oont:unit "kg".
<urn:object-ontology:harbor-city-delivery-ops#Shipment.promisedBy> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
    rdfs:range xsd:dateTime;
    rdfs:label "promisedBy";
    oont:apiName "promisedBy";
    oont:dataType "timestamp".
<urn:object-ontology:harbor-city-delivery-ops#Shipment.eta> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
