<urn:object-ontology:harbor-city-delivery-ops#DeliveryStop.address> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :DeliveryStop;
    rdfs:range xsd:string;
    rdfs:label "address";
    oont:apiName "address";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#DeliveryStop.sequence> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :DeliveryStop;
    rdfs:range xsd:integer;
    rdfs:label "sequence";
    oont:apiName "sequence";
    oont:dataType "integer".
<urn:object-ontology:harbor-city-delivery-ops#link/vehicleDepot> a oont:LinkType;
    rdfs:label "Based at";
    oont:apiName "vehicleDepot";
    oont:fromType :Vehicle;
    oont:toType :Depot;
    oont:fromSide <urn:object-ontology:harbor-city-delivery-ops#Vehicle.depot>;
