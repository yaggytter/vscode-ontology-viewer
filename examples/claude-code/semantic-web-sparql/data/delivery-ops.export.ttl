@prefix : <urn:object-ontology:harbor-city-delivery-ops#>.
@prefix oont: <urn:object-ontology:vocab#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<urn:object-ontology:harbor-city-delivery-ops#> a owl:Ontology;
    rdfs:label "Harbor City Delivery Ops";
    rdfs:comment "Last-mile delivery for a fictional harbor city: depots, vehicles, drivers, shipments and their stops, plus the dispatch actions an AI agent may call.".
:Trackable a owl:Class, oont:Interface;
    rdfs:label "Trackable";
    rdfs:comment "Anything with a current position on the map.";
    oont:apiName "Trackable".
<urn:object-ontology:harbor-city-delivery-ops#Trackable.lat> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Trackable;
    rdfs:range xsd:double;
    rdfs:label "lat";
    oont:apiName "lat";
    oont:dataType "double";
    oont:unit "deg".
<urn:object-ontology:harbor-city-delivery-ops#Trackable.lon> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Trackable;
    rdfs:range xsd:double;
    rdfs:label "lon";
    oont:apiName "lon";
    oont:dataType "double";
    oont:unit "deg".
:Depot a owl:Class, oont:ObjectType;
    rdfs:label "Depot";
    rdfs:comment "A warehouse where vehicles are based and shipments are loaded.";
    oont:apiName "Depot";
    oont:primaryKey <urn:object-ontology:harbor-city-delivery-ops#Depot.depotId>;
    oont:titleProperty <urn:object-ontology:harbor-city-delivery-ops#Depot.name>;
    oont:implements :Trackable;
    rdfs:subClassOf :Trackable.
<urn:object-ontology:harbor-city-delivery-ops#Depot.depotId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Depot;
    rdfs:range xsd:string;
    rdfs:label "depotId";
    oont:apiName "depotId";
    oont:dataType "string";
    oont:required true.
<urn:object-ontology:harbor-city-delivery-ops#Depot.name> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Depot;
    rdfs:range xsd:string;
    rdfs:label "name";
    oont:apiName "name";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Depot.lat> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Depot;
    rdfs:range xsd:double;
    rdfs:label "lat";
    oont:apiName "lat";
    oont:dataType "double";
    oont:unit "deg".
<urn:object-ontology:harbor-city-delivery-ops#Depot.lon> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Depot;
    rdfs:range xsd:double;
    rdfs:label "lon";
    oont:apiName "lon";
    oont:dataType "double";
    oont:unit "deg".
:Vehicle a owl:Class, oont:ObjectType;
    rdfs:label "Vehicle";
    rdfs:comment "A delivery van, truck or cargo bike.";
    oont:apiName "Vehicle";
    oont:primaryKey <urn:object-ontology:harbor-city-delivery-ops#Vehicle.vehicleId>;
    oont:titleProperty <urn:object-ontology:harbor-city-delivery-ops#Vehicle.plate>;
    oont:implements :Trackable;
    rdfs:subClassOf :Trackable.
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.vehicleId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:string;
    rdfs:label "vehicleId";
    oont:apiName "vehicleId";
    oont:dataType "string";
    oont:required true.
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.plate> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:string;
    rdfs:label "plate";
    oont:apiName "plate";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.kind> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:string;
    rdfs:label "kind";
    oont:apiName "kind";
    oont:dataType "string";
    oont:enumValue "van", "truck", "cargoBike".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.status> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:string;
    rdfs:label "status";
    oont:apiName "status";
    oont:dataType "string";
    oont:enumValue "available", "onRoute", "maintenance".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.capacityKg> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:double;
    rdfs:label "capacityKg";
    oont:apiName "capacityKg";
    oont:dataType "double";
    oont:unit "kg".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.loadKg> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:double;
    rdfs:label "loadKg";
    rdfs:comment "Weight already assigned to this vehicle.";
    oont:apiName "loadKg";
    oont:dataType "double";
    oont:unit "kg".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.depotId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:string;
    rdfs:label "depotId";
    oont:apiName "depotId";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.lat> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:double;
    rdfs:label "lat";
    oont:apiName "lat";
    oont:dataType "double";
    oont:unit "deg".
<urn:object-ontology:harbor-city-delivery-ops#Vehicle.lon> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Vehicle;
    rdfs:range xsd:double;
    rdfs:label "lon";
    oont:apiName "lon";
    oont:dataType "double";
    oont:unit "deg".
:Driver a owl:Class, oont:ObjectType;
    rdfs:label "Driver";
    rdfs:comment "A person licensed to drive a delivery vehicle.";
    oont:apiName "Driver";
    oont:primaryKey <urn:object-ontology:harbor-city-delivery-ops#Driver.driverId>;
    oont:titleProperty <urn:object-ontology:harbor-city-delivery-ops#Driver.name>.
