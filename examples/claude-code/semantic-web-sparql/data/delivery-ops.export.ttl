    oont:linkType <urn:object-ontology:harbor-city-delivery-ops#link/vehicleDriver>;
    rdfs:label "vehicle";
    oont:apiName "vehicle";
    oont:cardinality "one".
<urn:object-ontology:harbor-city-delivery-ops#link/shipmentCustomer> a oont:LinkType;
