<urn:object-ontology:harbor-city-delivery-ops#Driver.name> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Driver;
    rdfs:range xsd:string;
    rdfs:label "name";
    oont:apiName "name";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Driver.onShift> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Driver;
