<urn:object-ontology:harbor-city-delivery-ops#Shipment.customerNotified> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
    rdfs:range xsd:boolean;
    rdfs:label "customerNotified";
    oont:apiName "customerNotified";
    oont:dataType "boolean".
<urn:object-ontology:harbor-city-delivery-ops#Shipment.customerId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
    rdfs:range xsd:string;
    rdfs:label "customerId";
    oont:apiName "customerId";
    oont:dataType "string".
:DeliveryStop a owl:Class, oont:ObjectType;
