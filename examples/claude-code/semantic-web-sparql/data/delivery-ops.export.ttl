<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle> a oont:ActionType;
    rdfs:label "Assign vehicle";
    rdfs:comment "Put a pending or delayed shipment on a vehicle. Replaces any earlier vehicle assignment.";
    oont:apiName "assignVehicle";
    oont:affects :Shipment, :Vehicle;
    oont:parameter <urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/parameter/shipment>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/parameter/shipment> a oont:Parameter;
    rdfs:label "shipment";
    oont:apiName "shipment";
    oont:dataType "objectRef";
    oont:required true;
    oont:objectType :Shipment.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle> oont:parameter <urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/parameter/vehicle>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/parameter/vehicle> a oont:Parameter;
    rdfs:label "vehicle";
    oont:apiName "vehicle";
    oont:dataType "objectRef";
    oont:required true;
    oont:objectType :Vehicle.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle> oont:rule <urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/rule/1>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/rule/1> a oont:Rule;
    oont:op "createLink";
    oont:linkType <urn:object-ontology:harbor-city-delivery-ops#link/shipmentVehicle>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle> oont:rule <urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/rule/2>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle/rule/2> a oont:Rule;
    oont:op "modifyObject";
    oont:objectType :Shipment;
    oont:sets <urn:object-ontology:harbor-city-delivery-ops#Shipment.status>.
<urn:object-ontology:harbor-city-delivery-ops#action/assignVehicle> oont:validation "The vehicle must be available (not on route or in maintenance).", "The shipment must fit in the vehicle's remaining capacity.", "The vehicle must be based at the shipment's origin depot.";
    oont:sideEffect "The vehicle's driver receives the updated route.".
