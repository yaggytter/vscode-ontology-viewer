<urn:object-ontology:harbor-city-delivery-ops#Customer.name> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Customer;
    rdfs:range xsd:string;
    rdfs:label "name";
    oont:apiName "name";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Customer.email> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Customer;
    rdfs:range xsd:string;
    rdfs:label "email";
    oont:apiName "email";
    oont:dataType "string".
<urn:object-ontology:harbor-city-delivery-ops#Customer.preferredChannel> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Customer;
    rdfs:range xsd:string;
    rdfs:label "preferredChannel";
    oont:apiName "preferredChannel";
    oont:dataType "string";
    oont:enumValue "email", "sms".
:Shipment a owl:Class, oont:ObjectType;
    rdfs:label "Shipment";
    rdfs:comment "One parcel or pallet to be delivered.";
    oont:apiName "Shipment";
    oont:primaryKey <urn:object-ontology:harbor-city-delivery-ops#Shipment.shipmentId>;
    oont:titleProperty <urn:object-ontology:harbor-city-delivery-ops#Shipment.shipmentId>.
<urn:object-ontology:harbor-city-delivery-ops#Shipment.shipmentId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Shipment;
    rdfs:range xsd:string;
    rdfs:label "shipmentId";
    oont:apiName "shipmentId";
    oont:dataType "string";
