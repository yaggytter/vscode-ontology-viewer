    oont:apiName "Customer";
    oont:primaryKey <urn:object-ontology:harbor-city-delivery-ops#Customer.customerId>;
    oont:titleProperty <urn:object-ontology:harbor-city-delivery-ops#Customer.name>.
<urn:object-ontology:harbor-city-delivery-ops#Customer.customerId> a owl:DatatypeProperty, oont:Property;
    rdfs:domain :Customer;
    rdfs:range xsd:string;
    rdfs:label "customerId";
    oont:apiName "customerId";
    oont:dataType "string";
