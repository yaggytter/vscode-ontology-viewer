{
  "name": "ontology-viewer",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "AkihiroYAGASAKI",
  "author": {
    "name": "yaggytter",
    "url": "https://github.com/yaggytter"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ontology",
    "owl",
    "rdf",
    "rdfs",
    "turtle",
    "sparql",
    "semantic web",
    "knowledge graph",
    "skos",
    "json-ld",
    "rdf/xml",
    "diagram",
    "visual editor",
    "palantir-style ontology",
    "object ontology",
    "ai agent",
    "llm",
    "mcp"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#172033",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "markdown": "github",
  "qna": "https://github.com/yaggytter/vscode-ontology-viewer/issues",
  "badges": [
    {
      "url": "https://github.com/yaggytter/vscode-ontology-viewer/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/yaggytter/vscode-ontology-viewer/actions/workflows/ci.yml",
      "description": "Continuous integration status"
    }
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.oont.yaml",
    "workspaceContains:**/*.oont.yml",
    "workspaceContains:**/*.oont.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "turtle",
        "aliases": [
          "Turtle",
          "turtle"
        ],
        "extensions": [
          ".ttl",
          ".turtle"
        ],
        "configuration": "./language-configuration/turtle-language-configuration.json",
        "icon": {
          "light": "./media/file-icon-light.svg",
          "dark": "./media/file-icon-dark.svg"
        }
      },
      {
        "id": "trig",
        "aliases": [
          "TriG"
        ],
        "extensions": [
          ".trig"
        ],
        "configuration": "./language-configuration/turtle-language-configuration.json"
      },
      {
        "id": "ntriples",
        "aliases": [
          "N-Triples"
        ],
        "extensions": [
          ".nt"
        ],
        "configuration": "./language-configuration/turtle-language-configuration.json"
      },
      {
        "id": "notation3",
        "aliases": [
          "Notation3",
          "N3"
        ],
        "extensions": [
          ".n3"
        ],
        "configuration": "./language-configuration/turtle-language-configuration.json"
      },
      {
        "id": "rdfxml",
        "aliases": [
          "RDF/XML",
          "OWL/XML"
        ],
        "extensions": [
          ".rdf",
          ".owl"
        ]
      },
      {
        "id": "jsonld",
        "aliases": [
          "JSON-LD"
        ],
        "extensions": [
          ".jsonld"
        ]
      }
    ],
    "grammars": [
      {
        "language": "turtle",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      },
      {
        "language": "trig",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      },
      {
        "language": "ntriples",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      },
      {
        "language": "notation3",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      },
      {
        "language": "rdfxml",
        "scopeName": "source.rdfxml",
        "path": "./syntaxes/rdfxml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.xml": "xml"
        }
      },
      {
        "language": "jsonld",
        "scopeName": "source.jsonld",
        "path": "./syntaxes/jsonld.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.json": "json"
        }
      }
    ],
    "commands": [
      {
        "command": "ontologyViewer.openPreview",
        "title": "%command.openPreview.title%",
        "category": "%extension.category%",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "ontologyViewer.convertToTurtle",
        "title": "%command.convertToTurtle.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.exportLayout",
        "title": "%command.exportLayout.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.newSample",
        "title": "%command.newSample.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.exportAgentTools",
        "title": "%command.exportAgentTools.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.exportContextSummary",
        "title": "%command.exportContextSummary.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.exportObjectOntologyTurtle",
        "title": "%command.exportObjectOntologyTurtle.title%",
        "category": "%extension.category%"
      },
      {
        "command": "ontologyViewer.convertObjectOntologyToYaml",
        "title": "%command.convertObjectOntologyToYaml.title%",
        "category": "%extension.category%"
      }
    ],
    "keybindings": [
      {
        "command": "ontologyViewer.openPreview",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorLangId in ontologyViewer.viewableLanguages || (resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ontologyViewer.openPreview",
          "when": "editorLangId in ontologyViewer.viewableLanguages || (resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ontologyViewer.openPreview",
          "when": "editorLangId in ontologyViewer.viewableLanguages || (resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
        },
        {
          "command": "ontologyViewer.convertToTurtle",
          "when": "editorLangId in ontologyViewer.viewOnlyLanguages"
        },
        {
          "command": "ontologyViewer.exportLayout",
          "when": "editorLangId in ontologyViewer.viewableLanguages || (resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
        },
        {
          "command": "ontologyViewer.exportAgentTools",
          "when": "(resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
        },
        {
          "command": "ontologyViewer.exportContextSummary",
          "when": "(resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
        },
        {
          "command": "ontologyViewer.exportObjectOntologyTurtle",
          "when": "(resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology)"
        },
        {
          "command": "ontologyViewer.convertObjectOntologyToYaml",
          "when": "(resourceFilename =~ /\\.oont\\.(ya?ml|json)$/ || ontologyViewer.isObjectOntology) && editorLangId != yaml"
        }
      ]
    },
    "configuration": {
      "title": "%extension.category%",
      "properties": {
        "ontologyViewer.preview.autoRefreshDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 5000,
          "description": "%config.autoRefreshDebounceMs.description%"
        },
        "ontologyViewer.preview.defaultView": {
          "type": "string",
          "enum": [
            "schema",
            "triples"
          ],
          "default": "schema",
          "description": "%config.defaultView.description%"
        },
        "ontologyViewer.preview.layout": {
          "type": "string",
          "enum": [
            "fcose",
            "dagre"
          ],
          "default": "fcose",
          "description": "%config.layout.description%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "*.oont.json"
        ],
        "url": "./schemas/object-ontology.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "*.oont.yaml",
          "*.oont.yml"
        ],
        "url": "./schemas/object-ontology.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile:production",
    "compile": "node esbuild.mjs",
    "compile:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src webview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run compile && vscode-test",
    "pretest:integration": "tsc -p ./src/test/tsconfig.json",
    "validate:release": "node scripts/validate-release.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run validate:release",
    "package": "npm run validate:release && vsce package --no-dependencies",
    "publish:marketplace": "npm run validate:release && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.16.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@comunica/query-sparql-rdfjs": "^4.5.0",
    "@vscode/l10n": "^0.0.18",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-fcose": "^2.2.0",
    "jsonld-streaming-parser": "^5.0.1",
    "n3": "^2.1.1",
    "rdfxml-streaming-parser": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.4",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri@3": "3.1.9",
    "js-yaml@4": "4.3.2",
    "markdown-it@14": "14.3.3",
    "undici@7": "7.30.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yaggytter/vscode-ontology-viewer"
  },
  "homepage": "https://github.com/yaggytter/vscode-ontology-viewer/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/yaggytter/vscode-ontology-viewer/issues"
  }
}
